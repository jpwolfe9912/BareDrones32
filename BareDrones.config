# Betaflight / STM32F7X2 (S7X2) 4.0.1 May  1 2019 / 22:19:19 (25f4a5ffe) MSP API: 1.41

#define USE_ACC
#define USE_ACC_SPI_MPU6000
#define USE_GYRO
#define USE_GYRO_SPI_MPU6000
#define USE_BARO
#define USE_BARO_BMP280
#define USE_FLASH
#define USE_FLASH_W25Q128FV
#define USE_MAX7456

board_name NUCLEOF722
manufacturer_id STMI

# I/O
resource LED 1 C03
resource LED 2 C02
resource BEEPER 1 C08
set beeper_inversion = ON
set beeper_od = OFF

# ACC/GYRO
resource GYRO_CS 1 A04
set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set gyro_1_sensor_align = CW180

# SPI
resource SPI_SCK 1 A05
resource SPI_SDI 1 A06
resource SPI_SDO 1 A07

resource SPI_SCK 2 B13
resource SPI_SDI 2 B14
resource SPI_SDO 2 B15

resource SPI_SCK 3 C10
resource SPI_SDI 3 C11
resource SPI_SDO 3 B02

# I2C
resource I2C_SCL 3 C10
resource I2C_SDA 3 C09

# FLASH
resource FLASH_CS 1 B12
set flash_spi_bus = 2

# OSD
resource OSD_CS 1 C04
set max7456_spi_bus = 3

# ADC
resource ADC_BATT 1 C00
resource ADC_CURR 1 C01
set adc_device = 1

# SERIAL PORTS
resource SERIAL_TX 1 B06
resource SERIAL_RX 1 B07

resource SERIAL_TX 2 A02
resource SERIAL_RX 2 A03

resource SERIAL_TX 3 B10
resource SERIAL_RX 3 B11

resource SERIAL_TX 4 A00
resource SERIAL_RX 4 A01

resource SERIAL_TX 5 C12
resource SERIAL_RX 5 D02

resource SERIAL_TX 6 C06
resource SERIAL_RX 6 C07

# TIMERS
timer B04 AF2
# pin B04: TIM3 CH1 (AF2)
timer B05 AF2
# pin B05: TIM3 CH2 (AF2)
timer B00 AF2
# pin B00: TIM3 CH3 (AF2)
timer B01 AF2
# pin B01: TIM3 CH4 (AF2)
timer A15 AF1
# pin A15: TIM2 CH1 (AF1)
resource MOTOR 1 B04
resource MOTOR 2 B05
resource MOTOR 3 B00
resource MOTOR 4 B01
resource LED_STRIP 1 A15

# dma
dma ADC 1 0
# ADC 1: DMA2 Stream 0 Channel 0
dma pin B04 0
# pin B04: DMA1 Stream 4 Channel 5
dma pin B05 0
# pin B05: DMA1 Stream 5 Channel 5
dma pin B00 0
# pin B00: DMA1 Stream 7 Channel 5
dma pin B01 0
# pin B01: DMA1 Stream 2 Channel 5
dma pin A15 0
# pin A15: DMA1 Stream 5 Channel 3

# serial
serial 0 64 115200 57600 0 115200
serial 3 1 19200 57600 0 115200

# EXTRAS

# feature
feature RX_SERIAL
feature TELEMETRY
feature OSD

# master
set baro_bustype = I2C
set baro_i2c_device = 3
set serialrx_provider = CRSF
set adc_device = 2
set blackbox_device = SPIFLASH
set dshot_burst = ON
set motor_pwm_protocol = DSHOT600
set pinio_box = 0,255,255,255
set pinio_config = 129,1,1,1
set current_meter = ADC
set battery_meter = ADC